# Phase 1: use separate PostgreSQL development and test databases.
# These are fake placeholders. Never commit a real environment file.
# Database tests require BOTH URLs. TEST_DATABASE_URL never falls back to DATABASE_URL.
# Use distinct database names (not schemas); the test name must end in _test.
# Names: lowercase ASCII letters/digits/underscores, start with a letter, max 63 bytes.
# Only the optional sslmode URL query parameter is supported by test tooling.
# Both databases must be reachable and report their configured names before tests/migrations.
# db:local creates its own ignored .env on port 55432; these conventional-server examples use 5432.
DATABASE_URL=postgresql://returnwise:REPLACE_ME@127.0.0.1:5432/returnwise_dev
TEST_DATABASE_URL=postgresql://returnwise:REPLACE_ME@127.0.0.1:5432/returnwise_test
APP_BASE_URL=http://127.0.0.1:3000
# Prisma runtime/script connections set PostgreSQL sessions to UTC, independent of Windows timezone.
# Do not add a conflicting connection-string options parameter.
PAYPAL_ENV=sandbox

# Optional dedicated migration-owner connection (runtime can use a restricted role).
# DATABASE_MIGRATION_URL=postgresql://migration_owner:REPLACE_ME@127.0.0.1:5432/returnwise_dev

# Phase 2: set privately in .env, then restart the app. Never use live credentials.
# Missing credentials keep checkout disabled. Client ID alone is intentionally public in the SDK;
# the secret, merchant ID and webhook ID stay server-side. No NEXT_PUBLIC_ secret variables.
# Bind the local merchant with npm run paypal:configure -- --merchant=<local-UUID>.
# Register a genuine HTTPS webhook for this Sandbox app; simulator postback verification is unsupported.
# Leave PAYPAL_WEBHOOK_ID commented out until a real subscription exists (no placeholder in .env).
# API origin is fixed in code to https://api-m.sandbox.paypal.com; no API-base override exists.
# Webhook-only tunnel: npm.cmd run paypal:listener (port 3200); keep APP_BASE_URL local.
# PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
# PAYPAL_CLIENT_SECRET=replace_with_sandbox_secret
# PAYPAL_MERCHANT_ID=replace_with_sandbox_merchant_id
# PAYPAL_WEBHOOK_ID=replace_with_registered_sandbox_webhook_id

# Optional AG Studio trial/commercial licence with AI entitlement for hosted use.
# This browser licence is intentionally delivered to the client; it is not a provider API secret.
# Leave unset for local evaluation. Never commit an actual licence value.
# NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=replace_with_your_ag_studio_licence
# Optional DeepSeek evidence analysis and consented analytics questions.
# Never put a provider API key in NEXT_PUBLIC_* variables (the Studio licence above is a browser entitlement).
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_IMAGE_DETAIL=high
AI_MAX_OUTPUT_TOKENS=1200
# Lifetime application cap in USD; shared by all merchants, inclusive of reservations.
AI_SPENDING_CAP_USD=0.25

# Phase 7A: new hosted evidence must use Supabase; existing DB bytes stay readable.
EVIDENCE_STORAGE=database
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=replace_with_server_secret_or_legacy_service_role_key
# Private bucket is fixed: return-evidence; JPEG only; object limit <= 5242880 bytes.
EVIDENCE_STORAGE_CAP_BYTES=104857600
# Read-only published, sanitized snapshot; never grants a merchant session.
PUBLIC_DEMO_ENABLED=false
# Set true on Render only after confirming the trial permits this domain/public demo.
AG_STUDIO_HOSTED_AUTHORIZED=false
