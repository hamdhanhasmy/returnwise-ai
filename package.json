{
  "name": "returnwise-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sandbox-only merchant return resolution workspace",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:render": "tsx scripts/start-render.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium --no-shell",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "tsx scripts/migrate-test.ts",
    "db:seed": "tsx prisma/seed.ts",
    "returns:seed": "tsx prisma/seed-returns.ts",
    "demo:setup": "tsx scripts/setup-case-demo.ts",
    "returns:impact": "tsx scripts/evaluate-return-impact.ts",
    "ai:evaluate": "tsx scripts/evaluate-deepseek.ts",
    "evidence:purge": "tsx scripts/purge-evidence.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "auth:link": "tsx scripts/issue-login-link.ts",
    "paypal:configure": "tsx scripts/configure-paypal.ts",
    "paypal:verify": "tsx scripts/verify-paypal.ts",
    "paypal:listener": "tsx scripts/start-webhook-listener.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.119.0",
    "ag-studio": "3.1.0",
    "ag-studio-react": "3.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
